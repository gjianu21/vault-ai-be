# Copy to .env. The shared values must be identical to vault-ai-auth-server/.env.

# --- Oracle (container started from vault-ai-auth-server) ---
VAULT_APP_DB_PASSWORD=change-me-app

# --- Shared with vault-ai-auth-server ---
OAUTH2_CLIENT_SECRET=change-me-client-secret
INTERNAL_API_KEY=change-me-internal-key

# --- AI agent (not needed with the "mock" profile) ---
AGENT_BASE_URL=
AGENT_CHAT_PATH=/chat
AGENT_API_TOKEN=