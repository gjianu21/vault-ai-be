<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-bank-account" author="jianu">
        <createTable tableName="bank_account">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_bank_account" nullable="false"/>
            </column>
            <column name="owner_id" type="RAW(16)">
                <constraints nullable="false"/>
            </column>
            <column name="iban" type="VARCHAR2(34)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_bank_account_iban"/>
            </column>
            <column name="account_name" type="VARCHAR2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="account_type" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR2(3)">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="NUMBER(19,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="bank_account" indexName="ix_bank_account_owner">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-account-transaction" author="jianu">
        <createTable tableName="account_transaction">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_account_transaction" nullable="false"/>
            </column>
            <column name="account_id" type="RAW(16)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_type" type="VARCHAR2(10)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMBER(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR2(3)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR2(255)"/>
            <column name="counterparty_name" type="VARCHAR2(140)"/>
            <column name="counterparty_iban" type="VARCHAR2(34)"/>
            <column name="booked_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="balance_after" type="NUMBER(19,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="account_transaction"
                baseColumnNames="account_id"
                constraintName="fk_account_transaction_account"
                referencedTableName="bank_account"
                referencedColumnNames="id"/>

        <createIndex tableName="account_transaction" indexName="ix_account_tx_account_booked">
            <column name="account_id"/>
            <column name="booked_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>