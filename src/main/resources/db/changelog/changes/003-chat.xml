<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-chat-conversation" author="jianu">
        <createTable tableName="chat_conversation">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_chat_conversation" nullable="false"/>
            </column>
            <column name="owner_id" type="RAW(16)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR2(200)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="chat_conversation" indexName="ix_chat_conversation_owner">
            <column name="owner_id"/>
            <column name="updated_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-create-chat-message" author="jianu">
        <createTable tableName="chat_message">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_chat_message" nullable="false"/>
            </column>
            <column name="conversation_id" type="RAW(16)">
                <constraints nullable="false"/>
            </column>
            <column name="message_role" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="action_id" type="RAW(16)"/>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="chat_message"
                baseColumnNames="conversation_id"
                constraintName="fk_chat_message_conversation"
                referencedTableName="chat_conversation"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="chat_message" indexName="ix_chat_message_conversation">
            <column name="conversation_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>