<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-agent-action" author="jianu">
        <createTable tableName="agent_action">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_agent_action" nullable="false"/>
            </column>
            <column name="owner_id" type="RAW(16)">
                <constraints nullable="false"/>
            </column>
            <column name="conversation_id" type="RAW(16)"/>
            <column name="action_type" type="VARCHAR2(40)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR2(20)">
                <constraints nullable="false"/>
            </column>
            <column name="from_account_id" type="RAW(16)"/>
            <column name="to_iban" type="VARCHAR2(34)"/>
            <column name="amount" type="NUMBER(19,2)"/>
            <column name="currency" type="VARCHAR2(3)"/>
            <column name="description" type="VARCHAR2(140)"/>
            <column name="idempotency_key" type="VARCHAR2(100)">
                <constraints unique="true" uniqueConstraintName="uk_agent_action_idempotency"/>
            </column>
            <column name="result_message" type="VARCHAR2(500)"/>
            <column name="result_transaction_id" type="RAW(16)"/>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="decided_at" type="TIMESTAMP(6) WITH TIME ZONE"/>
        </createTable>

        <createIndex tableName="agent_action" indexName="ix_agent_action_owner_status">
            <column name="owner_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="agent_action" indexName="ix_agent_action_status_expires">
            <column name="status"/>
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>