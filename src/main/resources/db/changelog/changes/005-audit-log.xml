<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-audit-log" author="jianu">
        <createTable tableName="audit_log">
            <column name="id" type="RAW(16)">
                <constraints primaryKey="true" primaryKeyName="pk_audit_log" nullable="false"/>
            </column>
            <column name="owner_id" type="RAW(16)">
                <constraints nullable="false"/>
            </column>
            <column name="action_id" type="RAW(16)"/>
            <column name="event_type" type="VARCHAR2(40)">
                <constraints nullable="false"/>
            </column>
            <column name="action_type" type="VARCHAR2(40)"/>
            <column name="details" type="VARCHAR2(1000)"/>
            <column name="created_at" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="audit_log" indexName="ix_audit_log_owner_created">
            <column name="owner_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>